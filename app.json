{
  "expo": {
    "name": "RestoCloud",
    "slug": "RestoCloud",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/IconKitchen-Output/ios/AppIcon@3x.png",
    "scheme": "restocloud",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/IconKitchen-Output/ios/AppIcon@3x.png",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "RestoCloud uses Bluetooth to connect to your thermal receipt printer.",
        "NSBluetoothPeripheralUsageDescription": "RestoCloud uses Bluetooth to connect to your thermal receipt printer.",
        "NSLocalNetworkUsageDescription": "RestoCloud scans your local WiFi network to find and connect to your receipt printer.",
        "NSLocationWhenInUseUsageDescription": "RestoCloud needs location access to scan for nearby Bluetooth printers (required by Android/iOS Bluetooth APIs, not used for tracking)."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/IconKitchen-Output/android/res/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "backgroundImage": "./assets/IconKitchen-Output/android/res/mipmap-xxxhdpi/ic_launcher_background.png",
        "monochromeImage": "./assets/IconKitchen-Output/android/res/mipmap-xxxhdpi/ic_launcher_monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.animesh144.restocloud",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_WIFI_STATE",
        "ACCESS_NETWORK_STATE",
        "INTERNET"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/IconKitchen-Output/web/favicon.ico",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-splash-screen",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/IconKitchen-Output/android/res/mipmap-xxxhdpi/ic_launcher_foreground.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#d32f2f"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "991f233c-e54d-4dbc-a75a-71dc16fb138b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/991f233c-e54d-4dbc-a75a-71dc16fb138b",
      "fallbackToCacheTimeout": 60000
    },
    "owner": "animesh144"
  }
}
