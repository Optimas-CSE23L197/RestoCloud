{
  "expo": {
    "name": "RestoCloud",
    "slug": "RestoCloud",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/IconKitchen-Output/ios/AppIcon@3x.png",
    "scheme": "restocloud",
    "userInterfaceStyle": "light",

    "ios": {
      "supportsTablet": true,
      "icon": "./assets/IconKitchen-Output/ios/AppIcon@3x.png"
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/IconKitchen-Output/android/res/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "backgroundImage": "./assets/IconKitchen-Output/android/res/mipmap-xxxhdpi/ic_launcher_background.png",
        "monochromeImage": "./assets/IconKitchen-Output/android/res/mipmap-xxxhdpi/ic_launcher_monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.animesh144.restocloud"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/IconKitchen-Output/web/favicon.ico",
      "bundler": "metro"
    },

    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-splash-screen",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/IconKitchen-Output/android/res/mipmap-xxxhdpi/ic_launcher_foreground.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#d32f2f"
          }
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "991f233c-e54d-4dbc-a75a-71dc16fb138b"
      }
    },

    "runtimeVersion": {
      "policy": "appVersion"
    },

    "updates": {
      "url": "https://u.expo.dev/991f233c-e54d-4dbc-a75a-71dc16fb138b",
      "fallbackToCacheTimeout": 60000
    },

    "owner": "animesh144"
  }
}
